# Backend environment (Django). Copy to .env for reference; set these in the Vercel
# project settings for production. Every variable is optional locally.

# Required whenever DEBUG is off (startup fails without it): a long random string.
DJANGO_SECRET_KEY=change-me
# 1/true for local debugging. Defaults to off; manage.py (runserver) turns it on locally.
DJANGO_DEBUG=0
# Comma-separated hosts. The default already covers localhost and *.vercel.app;
# set this only for a custom domain, e.g. api.example.com,.vercel.app
ALLOWED_HOSTS=
# Only needed when the browser calls the API cross-origin (frontend VITE_API_BASE_URL
# set to the backend URL). With the /api rewrite the frontend is same-origin.
CORS_ALLOWED_ORIGINS=
# Optional regexes, e.g. ^https://eld-trip-planner-.*\.vercel\.app$ for preview deploys.
CORS_ALLOWED_ORIGIN_REGEXES=
# Total upstream (geocode + OSRM) time budget for one plan request, in seconds.
# Keep it below the function maxDuration in vercel.json (60 s).
PLAN_TIME_BUDGET_SECONDS=25
LOG_LEVEL=INFO
# Contact (repository URL or email) sent in the upstream User-Agent, as Nominatim's usage
# policy requires, e.g. https://github.com/<user>/eld-trip-planner
UPSTREAM_CONTACT=
# Per-IP rate limit of the /api/geocode autocomplete proxy.
GEOCODE_RATE=60/min
